# Copy to .env and fill in. .env is gitignored and must stay mode 0600.
# Used by docker compose for variable substitution in compose.yaml.

# qBittorrent Web UI credentials (http://192.168.1.7:8095, LAN only).
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# Series source used by torrent_source.get_episode_details().
# Base URL of the Stremio stream endpoint, up to but not including "/series".
# The worker appends "/series/<imdbID>%3A<season>%3A<episode>.json".
# Empty keeps episodes in "awaiting source" instead of failing them.
# Example: https://host.example/api/stremio/stream
STREAM_SOURCE_URL=

# Headers sent with every lookup. Adjust if the source rejects the defaults.
STREAM_SOURCE_REFERER=
STREAM_SOURCE_USER_AGENT=
