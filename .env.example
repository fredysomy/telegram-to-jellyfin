# Absolute path to the media library shared with the downloader.
MEDIA_LIBRARY_DIR=/home/fredy/Media Library

# Persistent Telegram Bot API and queue data.
TELEGRAM_BOT_API_DATA_DIR=/home/fredy/Home Server Data/Telegram/bot-api
TELEGRAM_STATE_DIR=/home/fredy/Home Server Data/Telegram/state

# Secret file consumed by both containers. Copy telegram-secrets.env.example
# to telegram-secrets.env and fill in the values.
TELEGRAM_SECRETS_FILE=./telegram-secrets.env

# Retry and operational settings.
FREE_SPACE_RESERVE_BYTES=10737418240
MAX_ATTEMPTS=5
GET_FILE_RETRY_WINDOW_SECONDS=1200
PROGRESS_INTERVAL_SECONDS=20
LOG_LEVEL=INFO
