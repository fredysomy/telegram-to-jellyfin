# Telegram ingestion secrets. Never commit or share this file.
# Copy to telegram-secrets.env (chown fredy, chmod 600) and fill in.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Telegram user id allowed to drive this bot. Commands only work in a private
# chat from exactly this id. Empty means the bot refuses everyone (fail closed).
# Send the bot any private message and it replies with your numeric id.
TELEGRAM_OWNER_ID=
# Optional: pin the private channel the bot ingests attachments from.
# Left empty, the first channel that posts is paired.
TELEGRAM_CHANNEL_ID=
